{
	"name": "aphs-web",
	"module": "index.ts",
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"private": true,
	"scripts": {
		"dev": "turbo run dev",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate"
	},
	"type": "module",
	"dependencies": {
		"turbo": "^2.10.13"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"packageManager": "bun@1.3.14"
}
